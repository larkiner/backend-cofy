# ============================================================
# PLANTILLA de secretos. Copia este archivo a secrets.properties
# y rellena los valores reales:
#     cp secrets.properties.example secrets.properties
# secrets.properties esta en .gitignore y NO debe subirse.
#
# En produccion, define estas claves como variables de entorno
# (tienen prioridad sobre el archivo).
# ============================================================

# Contrasenas de los usuarios Oracle de la aplicacion.
# Usa una contrasena DISTINTA y fuerte por usuario (refuerza la separacion
# de privilegios cliente/empleado). Deben coincidir con las de Oracle:
# tras cambiarlas, sincroniza con db/rotar_passwords_app.sql y reinicia.
DB_CLIENTE_PASSWORD=cambia-esto-por-una-fuerte-y-unica
DB_EMPLEADO_PASSWORD=cambia-esto-por-otra-distinta

# Secreto de firma JWT. DEBE tener >= 32 bytes. Genera uno con, p. ej.:
#     openssl rand -base64 48
JWT_SECRET=genera-un-secreto-largo-y-aleatorio

# Stripe (usa claves de prueba sk_test_... durante desarrollo).
# STRIPE_WEBHOOK_SECRET sale de `stripe listen` o del endpoint del Dashboard.
STRIPE_SECRET_KEY=sk_test_reemplaza_esta_clave
STRIPE_WEBHOOK_SECRET=whsec_reemplaza_este_secreto
