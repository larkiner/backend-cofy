# ============================================================
# PLANTILLA de entorno para docker-compose.
# Copia a .env y rellena los valores reales:
#     cp .env.example .env
# .env esta en .gitignore y NO debe subirse.
# ============================================================

# --- Base de datos Oracle ---
# Host:puerto del Oracle. Con el perfil "with-db" dejalo en
# oracle:1521. Con un Oracle externo pon su direccion real.
DB_HOST=oracle:1521
DB_SERVICE=XEPDB1

# Usuarios de la app (normalmente no hace falta cambiarlos).
DB_CLIENTE_USERNAME=CAFETERIA_CLIENTE_APP
DB_EMPLEADO_USERNAME=CAFETERIA_EMPLEADO_APP

# Contrasenas de los usuarios Oracle de la aplicacion.
DB_CLIENTE_PASSWORD=cambia-esto
DB_EMPLEADO_PASSWORD=cambia-esto

# Contrasena del usuario SYS del Oracle local (solo perfil with-db).
ORACLE_SYS_PASSWORD=cambia-esto

# --- JWT ---
# Debe tener >= 32 bytes. Genera uno con: openssl rand -base64 48
JWT_SECRET=genera-un-secreto-largo-y-aleatorio
JWT_EXPIRATION_MS=86400000

# --- App ---
# HOST_PORT es el puerto en TU maquina; SERVER_PORT es el puerto interno
# del contenedor (lo que ve Spring Boot). Distintos por si el 8080 del
# host ya esta ocupado por otra cosa.
HOST_PORT=8080
SERVER_PORT=8080
# En produccion PONER EN false (evita que el cliente autoconfirme el pago).
PAGOS_SIMULACION_HABILITADA=true
CORS_ALLOWED_ORIGINS=http://localhost:4200
JPA_SHOW_SQL=false

# --- Stripe ---
# En desarrollo usa las claves de prueba; nunca subas valores reales.
STRIPE_SECRET_KEY=sk_test_reemplaza_esta_clave
STRIPE_WEBHOOK_SECRET=whsec_reemplaza_este_secreto
STRIPE_CURRENCY=cop

# --- Imagenes de producto (Supabase Storage) ---
# Proyecto y bucket publico donde el ADMIN sube las fotos. La clave de servicio
# (service_role o "secret key" del panel de Supabase) NUNCA va al frontend ni al repo.
# Sin estas variables la API arranca igual y la subida responde 503.
SUPABASE_URL=https://jjbmnbhfnllzzeycbomn.supabase.co
SUPABASE_SERVICE_KEY=pega-aqui-la-clave-de-servicio
SUPABASE_BUCKET=imagenes
